{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "e9140cc1d4894de2a6d64718a9e0f57a",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "CircularFade (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -425.0,
            "y": 320.0,
            "width": 200.0,
            "height": 0.0
        }
    },
    "m_Slots": [
        {
            "m_Id": "c42e418795eb4cbaa0aa1ac17ac62df9"
        },
        {
            "m_Id": "53e7ef77dcd94fde8bcc33e9af2f1206"
        },
        {
            "m_Id": "d981bd761df44b1aaca335580b82e5a0"
        },
        {
            "m_Id": "d599bb50020f47c0a54a26f9cf91a01f"
        }
    ],
    "synonyms": [],
    "m_Precision": 1,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "CircularFade",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float aspect = 1.0;\nfloat2 center = float2(0.5, 0.5);\n#if !defined(SHADERGRAPH_PREVIEW)\nfloat2 screenSize = GetScaledScreenParams().xy;\naspect = screenSize.x / screenSize.y;\n// The fade quad's origin is a shared point in front of the center-eye anchor.\n// Project it separately for each eye so the aperture converges on that point.\nfloat3 target = TransformObjectToWorld(float3(0.0, 0.0, 0.0));\ncenter = ComputeNormalizedDeviceCoordinates(target, UNITY_MATRIX_VP);\n#endif\n\nfloat2 screenAspect = float2(aspect, 1.0);\nfloat2 farthestCorner = max(abs(center), abs(1.0 - center));\nfloat radius = length((UV - center) * screenAspect) / length(farthestCorner * screenAspect);\nfloat halfGradient = max(Softness * 0.5, 0.0001);\n// The gradient midpoint moves inward at a constant speed.\nfloat boundary = lerp(1.0 + halfGradient, -halfGradient, saturate(Opacity));\nAlpha = smoothstep(-halfGradient, halfGradient, radius - boundary);"
}

