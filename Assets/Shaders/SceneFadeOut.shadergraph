    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "FillEyeView",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "#if defined(SHADERGRAPH_PREVIEW)\nPosition = float3(UV - 0.5, 0.0);\n#else\n// Project a screen-sized quad separately for each eye.\nfloat3 worldPosition = ComputeWorldSpacePosition(UV, 0.5, UNITY_MATRIX_I_VP);\nPosition = TransformWorldToObject(worldPosition);\n#endif"
}

